# Set these privately in Vercel Project Settings > Environment Variables.
# The application reads environment variables; this file is not loaded automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Required only for first-time browser setup of a new, empty hosted database.
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(32))"
SETUP_TOKEN=replace-with-your-own-random-secret-at-least-32-characters
